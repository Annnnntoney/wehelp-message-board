# 只列變數名，真實值放 .env（本機）或 EC2 上的 ~/message-board/.env，不要 commit。

# RDS（MySQL）
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=message_board

# S3：EC2 用 IAM Role 取得權限，不需要 Access Key
AWS_REGION=ap-northeast-1
S3_BUCKET=

# CloudFront 網域，例如 dxxxx.cloudfront.net（不含 https://）
CLOUDFRONT_DOMAIN=

# 上傳限制
MAX_UPLOAD_MB=5
